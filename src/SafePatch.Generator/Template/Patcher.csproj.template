<Project Sdk="Microsoft.NET.Sdk">
  <!-- Generated by SafePatch.Generator from a trusted template. Do not edit: regenerate instead. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Only the listed trusted files are compiled; the payload is inert content. -->
    <EnableDefaultItems>false</EnableDefaultItems>
    <NoWarn>$(NoWarn);CS0436</NoWarn>
    <!-- As Synthesis's own patcher template: CET shadow stacks crash under MO2's usvfs hooks. -->
    <CETCompat>false</CETCompat>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />{{SettingsCompile}}
    <None Include="payload\manifest.json;payload\patch.bin;payload\patch.safe.cs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    {{RuntimeReference}}
  </ItemGroup>
</Project>
