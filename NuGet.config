<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Mutagen's Kernel, Core and Skyrim come from a local build of the fork (eng/mutagen-fork/Build-MutagenFork.ps1)
       until its changes are in a Mutagen release; everything else from nuget.org. -->
  <packageSources>
    <clear />
    <add key="mutagen-fork" value="%LOCALAPPDATA%\SafePatch\mutagen-fork" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="mutagen-fork">
      <package pattern="Mutagen.Bethesda.Kernel" />
      <package pattern="Mutagen.Bethesda.Core" />
      <package pattern="Mutagen.Bethesda.Skyrim" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
